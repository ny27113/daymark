# Frontend Firebase configuration. These values identify the Firebase web app
# and are not admin credentials. Never put server secrets under VITE_ names.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server/API configuration
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=

# Gemini Developer API. Server-only; never commit or expose this value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional first-load access gate. Keep both values server-only.
ACCESS_PASSWORD_HASH=
ACCESS_SESSION_SECRET=

# Optional latest AISC High School Daily Bulletin WordPress REST endpoint.
WORDPRESS_BULLETIN_API_URL=https://sites.aischennai.org/hsbulletin/wp-json/wp/v2/posts

# Development only; never enable this in a deployed environment.
LOCAL_DEV_AUTH=false
